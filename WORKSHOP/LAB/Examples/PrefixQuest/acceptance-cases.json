{
  "schemaVersion": 1,
  "purpose": "Independent lookup expectations for the proposed Prefix Quest implementation. This file is not a level pack or an executable test runner.",
  "model": "Already-installed IPv4 prefixes; unique prefix and route ID per table; longest matching prefix or drop; reject unsupported author data. Boundary cases check membership, not host-address usability.",
  "sources": [
    {
      "title": "RFC 1812",
      "url": "https://www.rfc-editor.org/rfc/rfc1812.html#section-5.2.4.3",
      "section": "5.2.4.3"
    },
    {
      "title": "RFC 5737",
      "url": "https://www.rfc-editor.org/rfc/rfc5737.html#section-3",
      "section": "3"
    }
  ],
  "cases": [
    {
      "id": "R1",
      "kind": "round",
      "challenge": {
        "destination": "192.0.2.42",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "B",
            "prefix": "198.51.100.0/24",
            "exit": "East"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "A"
      },
      "note": "Membership in the first /24."
    },
    {
      "id": "R2",
      "kind": "round",
      "challenge": {
        "destination": "198.51.100.14",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "B",
            "prefix": "198.51.100.0/24",
            "exit": "East"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "B"
      },
      "note": "Membership in the other /24."
    },
    {
      "id": "R3",
      "kind": "round",
      "challenge": {
        "destination": "192.0.2.130",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "B",
            "prefix": "192.0.2.128/25",
            "exit": "East"
          },
          {
            "id": "C",
            "prefix": "203.0.113.0/24",
            "exit": "West"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "B"
      },
      "note": "Both A and B match; B is more specific."
    },
    {
      "id": "R4",
      "kind": "round",
      "challenge": {
        "destination": "192.0.2.126",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "B",
            "prefix": "192.0.2.128/25",
            "exit": "East"
          },
          {
            "id": "C",
            "prefix": "203.0.113.0/24",
            "exit": "West"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "A"
      },
      "note": "The /25 does not match, despite having the longer prefix."
    },
    {
      "id": "R5",
      "kind": "round",
      "challenge": {
        "destination": "203.0.113.9",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "D",
            "prefix": "0.0.0.0/0",
            "exit": "Fallback"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "D"
      },
      "note": "Only the default route matches."
    },
    {
      "id": "R6",
      "kind": "round",
      "challenge": {
        "destination": "203.0.113.9",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          }
        ]
      },
      "expected": {
        "status": "drop",
        "routeId": null
      },
      "note": "No matching route and no default."
    },
    {
      "id": "E1",
      "kind": "edge",
      "challenge": {
        "destination": "192.0.2.130",
        "routes": [
          {
            "id": "D",
            "prefix": "0.0.0.0/0",
            "exit": "Fallback"
          },
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "B",
            "prefix": "192.0.2.128/25",
            "exit": "East"
          },
          {
            "id": "H",
            "prefix": "192.0.2.130/32",
            "exit": "Host"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "H"
      },
      "note": "Exact /32 match wins."
    },
    {
      "id": "E2",
      "kind": "edge",
      "challenge": {
        "destination": "192.0.2.131",
        "routes": [
          {
            "id": "D",
            "prefix": "0.0.0.0/0",
            "exit": "Fallback"
          },
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "B",
            "prefix": "192.0.2.128/25",
            "exit": "East"
          },
          {
            "id": "H",
            "prefix": "192.0.2.130/32",
            "exit": "Host"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "B"
      },
      "note": "A nearby /32 is not a match."
    },
    {
      "id": "E3",
      "kind": "edge",
      "challenge": {
        "destination": "203.0.113.200",
        "routes": [
          {
            "id": "D",
            "prefix": "0.0.0.0/0",
            "exit": "Fallback"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "D"
      },
      "note": "High-bit address with /0 catches signed-integer and zero-mask bugs."
    },
    {
      "id": "E4",
      "kind": "edge",
      "challenge": {
        "destination": "192.0.2.64",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "Q",
            "prefix": "192.0.2.64/26",
            "exit": "Quarter"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "Q"
      },
      "note": "Lower numeric boundary; membership only, not host-address usability."
    },
    {
      "id": "E5",
      "kind": "edge",
      "challenge": {
        "destination": "192.0.2.127",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "Q",
            "prefix": "192.0.2.64/26",
            "exit": "Quarter"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "Q"
      },
      "note": "Upper numeric boundary; membership only, not host-address usability."
    },
    {
      "id": "E6",
      "kind": "edge",
      "challenge": {
        "destination": "192.0.2.128",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "Q",
            "prefix": "192.0.2.64/26",
            "exit": "Quarter"
          }
        ]
      },
      "expected": {
        "status": "route",
        "routeId": "A"
      },
      "note": "First address beyond the /26 interval."
    },
    {
      "id": "E7",
      "kind": "edge",
      "challenge": {
        "destination": "203.0.113.9",
        "routes": []
      },
      "expected": {
        "status": "drop",
        "routeId": null
      },
      "note": "An empty table is valid and has no match."
    },
    {
      "id": "X1",
      "kind": "invalid",
      "challenge": {
        "destination": "192.0.2.999",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          }
        ]
      },
      "expected": {
        "status": "content-error",
        "routeId": null
      },
      "note": "Octet outside 0..255."
    },
    {
      "id": "X2",
      "kind": "invalid",
      "challenge": {
        "destination": "192.0.2.42",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/33",
            "exit": "North"
          }
        ]
      },
      "expected": {
        "status": "content-error",
        "routeId": null
      },
      "note": "Prefix length outside 0..32."
    },
    {
      "id": "X3",
      "kind": "invalid",
      "challenge": {
        "destination": "192.0.2.130",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.129/25",
            "exit": "North"
          }
        ]
      },
      "expected": {
        "status": "content-error",
        "routeId": null
      },
      "note": "Host bits set in the network address; do not silently normalize author data."
    },
    {
      "id": "X4",
      "kind": "invalid",
      "challenge": {
        "destination": "192.0.2.42",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "B",
            "prefix": "192.0.2.0/24",
            "exit": "East"
          }
        ]
      },
      "expected": {
        "status": "content-error",
        "routeId": null
      },
      "note": "Duplicate prefix would introduce an unsupported equal-prefix alternative."
    },
    {
      "id": "X5",
      "kind": "invalid",
      "challenge": {
        "destination": "192.0.2.42",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          },
          {
            "id": "A",
            "prefix": "198.51.100.0/24",
            "exit": "East"
          }
        ]
      },
      "expected": {
        "status": "content-error",
        "routeId": null
      },
      "note": "Duplicate route ID makes the choice ambiguous."
    },
    {
      "id": "X6",
      "kind": "invalid",
      "challenge": {
        "destination": "192.0.2.42",
        "routes": [
          {
            "id": "drop",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          }
        ]
      },
      "expected": {
        "status": "content-error",
        "routeId": null
      },
      "note": "The route ID drop is reserved for the no-match choice."
    },
    {
      "id": "X7",
      "kind": "invalid",
      "challenge": {
        "destination": "192.0.02.42",
        "routes": [
          {
            "id": "A",
            "prefix": "192.0.2.0/24",
            "exit": "North"
          }
        ]
      },
      "expected": {
        "status": "content-error",
        "routeId": null
      },
      "note": "Leading zeros are rejected by this authoring format."
    }
  ]
}
